{
  "info": {
    "_postman_id": "mrbio-daily-jobs",
    "name": "MrBio Daily Jobs",
    "description": "Daily AI game generators. Set collection variable cronSecret to CRON_SECRET. Use grade 10 first. Timeout 5 minutes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{cronSecret}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "cronSecret", "value": "" }
  ],
  "item": [
    {
      "name": "Daily all games",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grade\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/jobs/daily-all"
      }
    },
    {
      "name": "Daily quiz",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
